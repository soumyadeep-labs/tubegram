# Tubegram environment configuration
# Copy this file to .env.local for local development.

# Comma-separated allowlist of video platforms.
ALLOWED_DOMAINS=youtube.com,youtu.be,instagram.com

# Requests per minute per IP address. Keep this low on a public instance.
RATE_LIMIT_PER_MINUTE=10

# Safety caps. Videos over either limit are rejected.
MAX_VIDEO_DURATION_MINUTES=30
MAX_VIDEO_SIZE_MB=200

# How long a single download may run, in milliseconds.
DOWNLOAD_TIMEOUT_MS=600000

# Tool locations. Leave FFMPEG_PATH empty to use ffmpeg from PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=

# JavaScript runtime used by yt-dlp for YouTube. Set to an empty value to disable.
YTDLP_JS_RUNTIME=node
